APP_NAME="SRRU Activity System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srru_activity
DB_USERNAME=root
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
SRRU_EMAIL_DOMAIN=srru.ac.th

# Off (default) until the app is deployed on its final, stable domain — the
# "install app" shortcut it offers binds to whatever URL is open at install
# time, so offering it against a throwaway ngrok/preview URL just sets
# students up to install a shortcut that breaks later. Flip to true once
# deployed for real.
PWA_INSTALL_PROMPT_ENABLED=false

# Shown on the student "ติดต่อเรา" page alongside the chat. Leave
# phone/email/address blank to hide that row entirely rather than publish a
# placeholder — fill in the real กองพัฒนานักศึกษา details before deploying.
SRRU_OFFICE_PHONE=
SRRU_OFFICE_EMAIL=
SRRU_OFFICE_ADDRESS=
SRRU_OFFICE_HOURS="จันทร์–ศุกร์ 08:30–16:30 น. (ยกเว้นวันหยุดราชการ)"
SRRU_RESPONSE_TIME="โดยปกติตอบกลับภายใน 1–2 วันทำการ"

# Passwords for the "เข้าสู่ระบบแบบทดลอง" page (for evaluators without a
# university Google account) — each one logs into its own demo account.
# Leave both empty to disable the feature.
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=

FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# Firebase Web SDK config for browser push notifications (separate from the
# FIREBASE_CREDENTIALS service account above, which is server-side only).
# These four are NOT secret — they're meant to be public/client-visible —
# but a "Web" app has to exist in the Firebase console for this project
# before they exist at all: console.firebase.google.com > Project settings
# > General > Your apps > Add app (</> icon). VITE_FIREBASE_VAPID_KEY comes
# from the same project's Cloud Messaging tab > Web Push certificates
# (generate one if none exists yet).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shown to students as a "contact staff" link wherever a check-in is flagged
# or a request is rejected.
SUPPORT_CONTACT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
